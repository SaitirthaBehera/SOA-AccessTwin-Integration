# YOLO Model Configuration
MODEL_NAME=yolov8n.pt

# Gemini API Key for Multimodal Accessibility Reasoning & OCR
GEMINI_API_KEY=

# Set to 'true' to use fake detection for fast testing without YOLO
# Set to 'false' for actual YOLO inference
MOCK_MODE=false

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Confidence threshold for AI detection (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.35

# Maximum allowed size for uploaded images in MB
MAX_IMAGE_SIZE_MB=10